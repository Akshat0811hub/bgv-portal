APP_NAME="Orbit Verify"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://orbitverify.in
AUTO_INITIALIZE_DATABASE=false
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_NEW_BGV_DATABASE
DB_USERNAME=REPLACE_WITH_NEW_BGV_USER
DB_PASSWORD=REPLACE_IN_HOSTINGER
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=daily
LOG_LEVEL=warning
MAIL_MAILER=log
